// Example 5 - recovery as shadow use: the region `guard` may be replayed until it
// commits at `r`.  Replay needs its frontier (a, b) again, so the compiler keeps
// them alive past their last normal use: the recovery obligation is a *shadow use*.
//
//   ilc plan examples/recovery.lang
//   ilc run  examples/recovery.lang --inject-fault guard                     (recovers)
//   ilc run  examples/recovery.lang --inject-fault guard --ablate recovery-coupling   (fails: frontier released)
system Recovery {
    stato a : u8
    stato b : u8

    trasforma add(a, b) -> s
    trasforma inc(s) -> r
    emit r

    recupero guard {
        region = [s, r]
        policy = replay
        commit = r
    }
}
